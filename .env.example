# Local development only. `make env` generates random passwords and a signing key.
POSTGRES_DB=visionforge
POSTGRES_USER=visionforge
POSTGRES_PASSWORD=
# Host-side migrations use loopback; future API containers use postgres.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379
MINIO_ROOT_USER=visionforge
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Required by the HTTP API; keep private and stable across server restarts.
JWT_SECRET=
# Host-side API/CPU worker defaults; containers will use service DNS names.
REDIS_HOST=127.0.0.1
S3_REGION=us-east-1
S3_IMAGES_BUCKET=vf-images
S3_DATASETS_BUCKET=vf-datasets
S3_ARTIFACTS_BUCKET=vf-artifacts
S3_PREDICTIONS_BUCKET=vf-predictions
# Optional overrides: S3_ENDPOINT_URL (server) and S3_PUBLIC_ENDPOINT_URL (browser).
# Both otherwise use http://127.0.0.1:${MINIO_API_PORT}.
# Native API with a local Docker daemon; build first with `make inference-image`.
DEPLOYMENT_IMAGE=visionforge-inference:0.1.0
DEPLOYMENT_WORK_DIR=artifacts/deployments
PREDICTION_LOG_DIR=artifacts/predictions
DEPLOYMENT_NAMESPACE=visionforge
DEPLOYMENT_MAX_ACTIVE=2
DEPLOYMENT_CPU_THREADS=2
DEPLOYMENT_MEMORY_MB=1536
DEPLOYMENT_READY_SECONDS=90
DEPLOYMENT_NETWORK=visionforge_inference
TRAEFIK_PORT=8080
DEPLOYMENT_GATEWAY_URL=http://127.0.0.1:8080
DEPLOYMENT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
