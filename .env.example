# Local development only. `make env` fills the three empty passwords randomly.
POSTGRES_DB=visionforge
POSTGRES_USER=visionforge
POSTGRES_PASSWORD=
# Host-side migrations use loopback; future API containers use postgres.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379
MINIO_ROOT_USER=visionforge
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
