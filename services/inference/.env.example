# Copy to the ignored services/inference/.env and fill with one registered model.
# This service needs no database, storage or control-API credentials.
INFERENCE_BUNDLE_DIR=/home/user/visionforge/serving/model-v1
INFERENCE_MODEL_ID=<registered-model-uuid>
INFERENCE_MODEL_VERSION=1
INFERENCE_SLUG=casting-v1
INFERENCE_MODEL_SHA256=<sha256-returned-for-onnx-artifact>
INFERENCE_METADATA_SHA256=<sha256-returned-for-metadata-artifact>
INFERENCE_API_KEY_SHA256=<sha256-of-a-private-random-api-key>
INFERENCE_CPU_THREADS=2
